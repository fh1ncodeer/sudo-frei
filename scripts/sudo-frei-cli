#!/bin/bash
# sudo-frei-cli: time-limited passwordless sudo on your Linux machines, controlled from one place.
# The command line half of sudo-frei; `sudo-frei` itself is the TUI on top of it.
#
#   sudo-frei-cli grant HOST [MINUTES]   enable for MINUTES (default 30, max 240); asks for HOST's sudo password once
#   sudo-frei-cli revoke HOST            end early
#   sudo-frei-cli status [--raw] [HOST...]  show state (default: hosts from the config)
#
# HOST is an ssh name (e.g. Tailscale MagicDNS or ~/.ssh/config); "local" or this machine's
# hostname means this machine.
# Hosts come from ~/.config/sudo-frei/config.toml (`hosts = [...]`, see
# config.example.toml); without it, only this machine.
# status asks all hosts at once and gives each `status_timeout` seconds (default
# 2.3), hosts behind an ssh jump host `status_timeout_proxy` (default 8).
# --raw prints one tab-separated line per host for scripts and the TUI:
#   HOST<TAB>on<TAB>END_EPOCH | HOST<TAB>off<TAB> | HOST<TAB>orphan<TAB> | HOST<TAB>offline<TAB>
# (orphan: the rule is in place but its expiry timer is gone; revoke it).
# The rule applies to the user ssh logs in as. Nothing is installed on HOST; the
# code below is sent along with each call.
#
# A grant ends in three ways, whichever comes first:
#   - a transient systemd timer on HOST removes the rule after MINUTES,
#   - `sudo-frei-cli revoke HOST`,
#   - a reboot of HOST: systemd-tmpfiles deletes the rule at boot, so a timer
#     lost to a reboot never leaves passwordless sudo behind.
# Targets: systemd Linux with sudo (Arch, Debian, Ubuntu, Raspberry Pi OS).
# Raspberry Pi OS ships /etc/sudoers.d/010_pi-nopasswd, which makes sudo
# passwordless permanently; sudo-frei only means something there once that file is gone.
# The timer also deletes the user's sudo timestamp, so sudo's usual 5-minute
# grace period does not extend the window.
set -euo pipefail

CONFIG=${SUDO_FREI_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/sudo-frei/config.toml}
FALLBACK_HOSTS=(local)
DEFAULT_MIN=30
MAX_MIN=240
# Seconds per host in `status`; the config can override both.
STATUS_TIMEOUT=2.3
STATUS_TIMEOUT_PROXY=8 # hosts behind ProxyJump/ProxyCommand: two ssh handshakes

# Runs on the target host as the login user: bash -c "$REMOTE" sudo-frei ACTION [MINUTES]
read -r -d '' REMOTE <<'EOF' || true
set -euo pipefail
RULE=/etc/sudoers.d/zz-sudo-frei
CLEANUP=/etc/tmpfiles.d/sudo-frei.conf
# World-readable marker holding the grant's end (epoch). It is created and
# removed together with RULE, so the user can see the state without sudo
# (/etc/sudoers.d itself is not readable).
MARK=/run/sudo-frei-until
# Serializes grant and revoke, so two of them cannot interleave.
# In a root-only directory: flock works on read-only fds, so a lock file anyone
# can open could be held by any local user to stall expiry.
LOCK=/run/sudo-frei/lock
LOCK_WAIT=60
# Names used by versions before the English rename; still cleaned up.
LEGACY_MARK=/run/sudo-frei-ende
LEGACY_UNIT=sudo-frei-ende
# Directory holding sudo/ts and sudo-rs/ts timestamps; overridable only for scripts/sudo-frei-test.
TSROOT=/run
UNIT=sudo-frei-expire
MAX_MIN=240
host=$(uname -n)
user=$(id -un)
uid=$(id -u)
die() { echo "sudo-frei@$host: $*" >&2; exit 1; }
[[ $uid -ne 0 ]] || die "login user is root; sudo-frei is for normal users."
# The name goes into sudoers as is; keep it to plain names (no ALL, %group, #uid, quoting).
[[ $user =~ ^[a-z_][a-z0-9_.-]*$ ]] || die "user name '$user' is not supported."

# root_* run as root inside ONE sudo call with HUP/INT/TERM ignored, so a
# dropped connection or Ctrl-C cannot stop them between steps.
root_lock() {
  install -d -o root -g root -m 0700 "${LOCK%/*}"
  exec 9>"$LOCK"
  flock -w "$LOCK_WAIT" 9 || { echo "another sudo-frei run holds $LOCK, try again." >&2; return 1; }
}
root_stop_timers() { # stop all sudo-frei timers except unit $1
  local u
  for u in $(systemctl list-units --all --plain --no-legend --type=timer "$UNIT*" "$LEGACY_UNIT*" | awk '{print $1}'); do
    [[ -n ${1:-} && $u == "$1.timer" ]] && continue
    systemctl stop "$u" "${u%.timer}.service" 2>/dev/null || true
    systemctl reset-failed "$u" "${u%.timer}.service" 2>/dev/null || true
  done
}
root_ts_files() { # the user's sudo timestamps; sudo >= 1.9.15 names them by uid, older ones and sudo-rs vary
  printf '%s\n' "$TSROOT/sudo/ts/$user" "$TSROOT/sudo/ts/$uid" "$TSROOT/sudo-rs/ts/$user" "$TSROOT/sudo-rs/ts/$uid"
}
root_revoke() {
  trap '' HUP INT TERM
  root_lock
  # Rule first: whatever happens afterwards, nothing passwordless is left.
  rm -f "$RULE" "$RULE.new" "$RULE.new.tmp" "$MARK" "$MARK.new" "$MARK.new.tmp" "$LEGACY_MARK"
  root_stop_timers
  local ts
  mapfile -t ts < <(root_ts_files)
  rm -f "${ts[@]}"
}
root_put() { # root_put MODE DEST: stdin -> DEST (root:root, MODE), replacing DEST atomically
  # Via a temp file and rename, never onto an existing file: uutils install
  # (Ubuntu 25.10+) fails when copying /dev/stdin over one, and DEST keeps its
  # old content until the new one is complete. The temp name has a dot and no
  # .conf ending, so sudo and tmpfiles.d both skip it.
  rm -f "$2.tmp" && install -o root -g root -m "$1" /dev/stdin "$2.tmp" && mv -f "$2.tmp" "$2" && return 0
  rm -f "$2.tmp"
  return 1
}
root_stage() { # write rule line $1 to RULE.new (sudo skips names with a dot); 2 = write failed, 1 = rejected
  # Explicit returns: callers use this in a condition, where set -e is off.
  printf '# Written by sudo-frei; removed by %s-*.timer and at boot (%s).\n%s\n' "$UNIT" "$CLEANUP" "$1" |
    root_put 0440 "$RULE.new" || return 2
  visudo -c -f "$RULE.new" >/dev/null 2>&1 || return 1
}
root_grant() { # $1 = minutes; prints the end epoch
  trap '' HUP INT TERM
  root_lock
  local min=$1 end unit ts rc=0
  [[ $min =~ ^[0-9]{1,4}$ ]] && (( 10#$min >= 1 && 10#$min <= MAX_MIN )) || { echo "bad minutes: $min" >&2; return 1; }
  # The deadline starts now, after sudo authenticated, not when the command was typed.
  end=$(( $(date +%s) + 10#$min * 60 ))
  unit="$UNIT-$end-$$"
  mapfile -t ts < <(root_ts_files)
  # NOTAFTER makes classic sudo ignore the rule after the deadline even if the
  # timer is lost. sudo-rs rejects the option, so fall back to the plain rule.
  # Plain -c -f (no -q): also understood by sudo-rs, Ubuntu's default sudo since 25.10.
  root_stage "$user ALL=(ALL:ALL) NOTAFTER=$(date -u -d "@$end" '+%Y%m%d%H%M%SZ') NOPASSWD: ALL" || rc=$?
  if (( rc == 1 )); then
    rc=0
    root_stage "$user ALL=(ALL:ALL) NOPASSWD: ALL" || rc=$?
  fi
  if (( rc )); then
    rm -f "$RULE.new"
    echo "could not write a rule visudo accepts, nothing changed." >&2
    return 1
  fi
  # Order: stage marker, boot cleanup, new timer; then swap marker and rule in
  # by rename, then the old timers off. Until the swap, a failure leaves the
  # previous grant as it was, and the new timer is cancelled again.
  printf '%s\n' "$end" | root_put 0444 "$MARK.new"
  printf 'r %s\nr %s\nr %s\n' "$RULE" "$RULE.new" "$MARK" | root_put 0644 "$CLEANUP"
  # Wall-clock deadline in UTC, not --on-active: monotonic timers pause during
  # suspend, and local times are ambiguous at the DST switch. A calendar timer
  # whose time passed during suspend fires on resume. AccuracySec defaults to 1 min.
  if ! systemd-run --quiet --collect --unit="$unit" --timer-property=AccuracySec=1s \
    --on-calendar="$(date -u -d "@$end" '+%Y-%m-%d %H:%M:%S') UTC" \
    /usr/bin/rm -f "$RULE" "$MARK" "${ts[@]}"; then
    rm -f "$RULE.new" "$MARK.new"
    echo "could not start the expiry timer, nothing changed." >&2
    return 1
  fi
  # The timer does not take the lock: if an old one fires during this run, it
  # can only remove a rule early, which is the safe direction.
  if ! { mv -f "$MARK.new" "$MARK" && mv -f "$RULE.new" "$RULE"; }; then
    systemctl stop "$unit.timer" "$unit.service" 2>/dev/null || true
    rm -f "$RULE.new" "$MARK.new"
    echo "could not install the rule, previous state kept." >&2
    return 1
  fi
  if ! visudo -c >/dev/null 2>&1; then
    rm -f "$RULE" "$MARK"
    root_stop_timers
    echo "sudoers check failed after install, all sudo-frei rules removed." >&2
    return 1
  fi
  # Old timers go last; we hold the lock, so none of them can have fired meanwhile.
  root_stop_timers "$unit"
  echo "$end"
}
as_root() { # as_root FUNCTION ARGS...
  sudo env RULE="$RULE" CLEANUP="$CLEANUP" MARK="$MARK" LOCK="$LOCK" LOCK_WAIT="$LOCK_WAIT" UNIT="$UNIT" TSROOT="$TSROOT" \
    LEGACY_MARK="$LEGACY_MARK" LEGACY_UNIT="$LEGACY_UNIT" \
    MAX_MIN="$MAX_MIN" user="$user" uid="$uid" \
    bash -c "set -euo pipefail; $(declare -f root_lock root_stop_timers root_ts_files root_revoke root_put root_stage root_grant); \"\$@\"" sudo-frei "$@"
}

case $1 in
  state)
    # "on END_EPOCH", "off", or "orphan" (rule without a working timer); needs no sudo.
    if [[ -e $LEGACY_MARK ]]; then
      echo "orphan" # left by an older version; revoke cleans it up
    elif [[ -e $MARK ]]; then
      read -r end <"$MARK" || end=""
      [[ $end =~ ^[0-9]+$ ]] || end=0
      if (( end + 60 >= $(date +%s) )) &&
        systemctl list-units --plain --no-legend --type=timer --state=active "$UNIT*" | grep -q .; then
        echo "on $end"
      else
        echo "orphan"
      fi
    else
      echo "off"
    fi
    ;;
  revoke)
    as_root root_revoke || die "revoke failed."
    sudo -K 2>/dev/null || true
    echo "$host: off, sudo asks for the password again."
    ;;
  grant)
    end=$(as_root root_grant "$2") || die "not granted."
    [[ $end =~ ^[0-9]+$ ]] || die "unexpected answer from the root part: $end"
    # Prove it works without cached credentials: the rule could be valid yet
    # unused (sudoers.d not included, or overridden by a later rule).
    if ! sudo -n -k true 2>/dev/null; then
      as_root root_revoke || true
      die "rule installed, but sudo still wants a password (is /etc/sudoers.d included?). Removed again."
    fi
    echo "$host: on for $user until $(date -d "@$end" '+%H:%M %Z') ($2 min)."
    ;;
esac
EOF

die() { echo "sudo-frei-cli: $*" >&2; exit 1; }
usage() { sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; }

# read_config: take the hosts and the status timeouts from $CONFIG, if it exists.
CONFIG_HOSTS=()
read_config() {
  [[ -f $CONFIG ]] || return 0
  local out lines h
  # Prints the two timeouts (given defaults unless set), then one host per line.
  out=$(python3 -I -c 'import sys, tomllib
c = tomllib.load(open(sys.argv[1], "rb"))
h = c.get("hosts") or []
if not isinstance(h, list) or not all(isinstance(x, str) for x in h):
    sys.exit("hosts must be a list of strings")
for key, default in zip(("status_timeout", "status_timeout_proxy"), sys.argv[2:]):
    v = c.get(key, float(default))
    if isinstance(v, bool) or not isinstance(v, (int, float)) or not 0.1 <= v <= 60:
        sys.exit(key + " must be a number of seconds between 0.1 and 60")
    print(f"{v:.3f}")
print(*h, sep="\n")' "$CONFIG" "$STATUS_TIMEOUT" "$STATUS_TIMEOUT_PROXY") ||
    die "could not read $CONFIG."
  mapfile -t lines <<<"$out"
  STATUS_TIMEOUT=${lines[0]} STATUS_TIMEOUT_PROXY=${lines[1]}
  for h in "${lines[@]:2}"; do
    [[ -z ${h//[[:space:]]/} ]] || CONFIG_HOSTS+=("$h")
  done
}

is_local() { [[ $1 == local || $1 == "$(uname -n)" ]]; }

# host_timeout HOST: seconds `status` waits for HOST. Going through a jump host
# takes two ssh handshakes, which the short timeout often cuts off.
host_timeout() {
  if ! is_local "$1" && ssh -G -- "$1" 2>/dev/null |
    awk '($1 == "proxyjump" || $1 == "proxycommand") && $2 != "none" { found = 1 } END { exit !found }'; then
    echo "$STATUS_TIMEOUT_PROXY"
  else
    echo "$STATUS_TIMEOUT"
  fi
}

# run_on HOST ACTION [MINUTES]; interactive=1 allocates a tty so sudo can ask for the password.
run_on() {
  local host=$1 interactive=$2
  shift 2
  [[ $host =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "invalid host name: $host"
  if is_local "$host"; then
    bash -c "$REMOTE" sudo-frei "$@"
    return
  fi
  local b64 opts=(-o ConnectTimeout=8)
  b64=$(base64 -w0 <<<"$REMOTE")
  if (( interactive )) && [[ -t 0 ]]; then
    opts+=(-t)
  else
    opts+=(-o BatchMode=yes)
  fi
  # Arguments are validated words (grant/revoke/state, a number), safe to pass unquoted.
  # Decode first and stop if that fails: bash -c "" would exit 0 and fake success.
  # ssh hands the command to the login shell, which may be fish or csh: all they
  # get to parse is one single-quoted word for bash (base64 has no quotes).
  ssh "${opts[@]}" "$host" "bash -c 'c=\$(echo $b64 | base64 -d) && [ -n \"\$c\" ] && exec bash -c \"\$c\" sudo-frei $*'"
}

action=${1:-}
case $action in
  grant)
    host=${2:-} min=${3:-$DEFAULT_MIN}
    [[ -n $host ]] || die "which host? sudo-frei-cli grant HOST [MINUTES]"
    # Decimal only (bash reads 010 as octal), and short enough not to overflow.
    [[ $min =~ ^[0-9]{1,4}$ ]] && (( 10#$min >= 1 && 10#$min <= MAX_MIN )) ||
      die "minutes must be between 1 and $MAX_MIN."
    min=$(( 10#$min ))
    run_on "$host" 1 grant "$min"
    ;;
  revoke)
    host=${2:-}
    [[ -n $host ]] || die "which host? sudo-frei-cli revoke HOST"
    run_on "$host" 1 revoke
    ;;
  status)
    shift
    raw=0
    [[ ${1:-} == --raw ]] && { raw=1; shift; }
    read_config
    hosts=("$@")
    (( ${#hosts[@]} )) || hosts=("${CONFIG_HOSTS[@]}")
    (( ${#hosts[@]} )) || hosts=("${FALLBACK_HOSTS[@]}")
    # All hosts in parallel, each capped at its timeout, printed in the given order.
    out=$(mktemp -d)
    trap 'rm -rf "$out"' EXIT
    for i in "${!hosts[@]}"; do
      (
        timeout "$(host_timeout "${hosts[$i]}")" "$0" _state1 "${hosts[$i]}" >"$out/$i" 2>/dev/null ||
          echo offline >"$out/$i"
      ) &
    done
    wait
    now=$(date +%s)
    for i in "${!hosts[@]}"; do
      h=${hosts[$i]}
      state=offline end=""
      read -r state end <"$out/$i" || true
      # Remote output is untrusted: only known words, and a plain number for
      # "on" (bash would evaluate e.g. x[$(cmd)] inside $(( ))).
      case $state in
        on) [[ $end =~ ^[0-9]+$ ]] || state=offline ;;
        off | orphan) end="" ;;
        *) state=offline end="" ;;
      esac
      if (( raw )); then
        printf '%s\t%s\t%s\n' "$h" "$state" "$end"
      elif [[ $state == on ]]; then
        echo "$h: on until $(date -d "@$end" +%H:%M) ($(( (end - now + 59) / 60 )) min left)"
      elif [[ $state == off ]]; then
        echo "$h: off"
      elif [[ $state == orphan ]]; then
        echo "$h: WARNING passwordless sudo without an expiry timer. End it: sudo-frei-cli revoke $h"
      else
        echo "$h: unreachable"
      fi
    done
    ;;
  _remote)
    # Internal: print the code that runs on the target, for scripts/sudo-frei-test.
    printf '%s\n' "$REMOTE"
    ;;
  _state1)
    # Internal: one host's state line, run under timeout by `status`.
    run_on "$2" 0 state
    ;;
  -h | --help | help | "") usage ;;
  *) die "unknown command: $action (grant, revoke, status)" ;;
esac
