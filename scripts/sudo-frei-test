#!/bin/bash
# sudo-frei-test: check the root steps of sudo-frei (grant, re-grant, failure, revoke)
# without root, sudo or ssh.
#
# The root functions are taken from `sudo-frei-cli _remote` and run as the normal
# user against a fresh `mktemp -d` sandbox: RULE, MARK, CLEANUP and TSROOT point
# into it, and systemctl, systemd-run, visudo, install, mv, rm and date are replaced by small
# fakes in the sandbox's bin/ that only record calls and write inside the sandbox.
# Nothing outside the sandbox is written; the sandbox is left in place for inspection.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
S=$(mktemp -d "${TMPDIR:-/tmp}/sudo-frei-test.XXXXXX")
mkdir -p "$S/bin" "$S/etc/sudoers.d" "$S/etc/tmpfiles.d" "$S/run/sudo/ts"
: >"$S/units"

# --- fakes ------------------------------------------------------------------
cat >"$S/bin/systemctl" <<'EOF'
#!/bin/bash
# Timers live as lines in $SB/units.
echo "systemctl $*" >>"$SB/log"
case $1 in
  list-units) sed 's/$/ loaded active waiting x/' "$SB/units" ;;
  stop)
    shift
    for u in "$@"; do grep -vxF -- "$u" "$SB/units" >"$SB/units.tmp" || true; mv "$SB/units.tmp" "$SB/units"; done
    ;;
esac
EOF
cat >"$S/bin/systemd-run" <<'EOF'
#!/bin/bash
echo "systemd-run $*" >>"$SB/log"
[[ -z ${FAIL_RUN:-} ]] || exit 1
for a in "$@"; do [[ $a == --unit=* ]] && echo "${a#--unit=}.timer" >>"$SB/units"; done
exit 0
EOF
cat >"$S/bin/visudo" <<'EOF'
#!/bin/bash
# FAIL_NOTAFTER=1 acts like sudo-rs, which rejects the NOTAFTER option.
echo "visudo $*" >>"$SB/log"
# FAIL_CHECK=1: the check of the whole configuration after the swap fails.
if [[ -n ${FAIL_CHECK:-} && $* == -c ]]; then exit 1; fi
if [[ -n ${FAIL_NOTAFTER:-} && $1 == -c && ${2:-} == -f ]] && grep -q NOTAFTER "$3"; then exit 1; fi
exit 0
EOF
cat >"$S/bin/date" <<'EOF'
#!/bin/bash
# "now" is fixed by FAKE_NOW; everything else is the real date.
[[ $* == +%s ]] && { echo "$FAKE_NOW"; exit 0; }
exec /usr/bin/date "$@"
EOF
cat >"$S/bin/install" <<'EOF'
#!/bin/bash
# Like install, minus -o/-g (needs root), and as picky as uutils install
# (Ubuntu 25.10+): copying /dev/stdin over an existing file fails.
args=()
while (($#)); do case $1 in -o | -g) shift 2 ;; *) args+=("$1"); shift ;; esac; done
if [[ ${args[-2]} == /dev/stdin && -e ${args[-1]} ]]; then
  echo "install: cannot overwrite ${args[-1]} from /dev/stdin" >&2
  exit 1
fi
exec /usr/bin/install "${args[@]}"
EOF
cat >"$S/bin/mv" <<'EOF'
#!/bin/bash
# FAIL_MV=NAME: renaming onto a file called NAME fails.
if [[ -n ${FAIL_MV:-} && ${!#} == */"$FAIL_MV" ]]; then
  echo "mv: cannot move to ${!#}" >&2
  exit 1
fi
exec /usr/bin/mv "$@"
EOF
cat >"$S/bin/rm" <<'EOF'
#!/bin/bash
# FAIL_RM=NAME: a file called NAME cannot be removed; like the real rm, the
# others still are.
rc=0 args=()
for a in "$@"; do
  if [[ -n ${FAIL_RM:-} && $a == */"$FAIL_RM" ]]; then
    echo "rm: cannot remove $a" >&2
    rc=1
  else
    args+=("$a")
  fi
done
/usr/bin/rm "${args[@]}" || rc=1
exit "$rc"
EOF
chmod +x "$S"/bin/*

# --- root functions from the real script --------------------------------------
funcs=$(bash -c "$("$here/sudo-frei-cli" _remote)"$'\n'"declare -f root_lock root_stop_timers root_ts_files root_clear root_revoke root_put root_stage root_grant" sudo-frei _none)

root() { # root FUNCTION ARGS... with all paths inside the sandbox
  env SB="$S" PATH="$S/bin:$PATH" FAIL_RUN="${FAIL_RUN:-}" FAIL_NOTAFTER="${FAIL_NOTAFTER:-}" FAIL_MV="${FAIL_MV:-}" \
    FAIL_RM="${FAIL_RM:-}" FAIL_CHECK="${FAIL_CHECK:-}" \
    FAKE_NOW="${FAKE_NOW:-1999999700}" LOCK="$S/run/sudo-frei/lock" LOCK_WAIT="${LOCK_WAIT:-60}" MAX_MIN=240 \
    LEGACY_MARK="$S/run/sudo-frei-ende" LEGACY_UNIT=sudo-frei-ende \
    RULE="$S/etc/sudoers.d/zz-sudo-frei" CLEANUP="$S/etc/tmpfiles.d/sudo-frei.conf" \
    MARK="$S/run/sudo-frei-until" TSROOT="$S/run" UNIT=sudo-frei-expire user=tester uid=1000 \
    bash -c "set -euo pipefail; $funcs; \"\$@\"" sudo-frei "$@"
}

fails=0
check() { # check DESCRIPTION COMMAND...
  if "${@:2}"; then echo "ok   $1"; else echo "FAIL $1"; fails=$((fails + 1)); fi
}
timers() { wc -l <"$S/units"; }

R="$S/etc/sudoers.d/zz-sudo-frei"
M="$S/run/sudo-frei-until"
touch "$S/run/sudo/ts/tester" "$S/run/sudo/ts/1000"

# 1. grant: 5 min from FAKE_NOW 1999999700 ends at 2000000000 = 2033-05-18 03:33:20 UTC
out=$(root root_grant 5)
check "grant: prints the end" test "$out" = 2000000000
check "grant: rule installed, mode 0440" test "$(stat -c %a "$R")" = 440
check "grant: rule carries NOTAFTER" grep -q 'tester ALL=(ALL:ALL) NOTAFTER=20330518033320Z NOPASSWD: ALL' "$R"
check "grant: marker holds end" grep -qx 2000000000 "$M"
check "grant: boot cleanup lists rule and marker" grep -q zz-sudo-frei "$S/etc/tmpfiles.d/sudo-frei.conf"
check "grant: exactly one timer" test "$(timers)" -eq 1
check "grant: deadline in UTC, AccuracySec=1s" grep -q -- '--timer-property=AccuracySec=1s --on-calendar=2033-05-18 03:33:20 UTC' "$S/log"
check "grant: timer removes rule and marker" grep -q -- "UTC /usr/bin/rm -f $S/etc/sudoers.d/zz-sudo-frei $S/run/sudo-frei-until" "$S/log"
check "grant: lock dir is root-only (0700)" test "$(stat -c %a "$S/run/sudo-frei")" = 700
check "grant: timer removes the uid timestamp" grep -q -- "$S/run/sudo/ts/1000" "$S/log"
check "grant: no staged rule or marker left" test ! -e "$R.new" -a ! -e "$M.new"
check "grant: no temp files left" test -z "$(find "$S/etc" "$S/run" -name '*.tmp')"

# 2. re-grant: new timer replaces the old one, files left by an interrupted run do not get in the way
touch "$R.new" "$R.new.tmp" "$M.new" "$M.new.tmp" "$S/etc/tmpfiles.d/sudo-frei.conf.tmp"
root root_grant 15 >/dev/null
check "re-grant: still exactly one timer" test "$(timers)" -eq 1
check "re-grant: it is the new one" grep -q -- '-2000000600-' "$S/units"
check "re-grant: marker updated" grep -qx 2000000600 "$M"
check "re-grant: no leftovers remain" test -z "$(find "$S/etc" "$S/run" -name '*.new' -o -name '*.tmp')"

# 3. re-grant where systemd-run fails: the previous grant stays as it was
cp "$R" "$S/rule.before"
if FAIL_RUN=1 root root_grant 30 >/dev/null 2>&1; then rc=0; else rc=$?; fi
check "failed re-grant: reports failure" test "$rc" -ne 0
check "failed re-grant: old timer kept" grep -q -- '-2000000600-' "$S/units"
check "failed re-grant: old marker kept" grep -qx 2000000600 "$M"
check "failed re-grant: old rule kept" cmp -s "$R" "$S/rule.before"
check "failed re-grant: no staged rule or marker left" test ! -e "$R.new" -a ! -e "$M.new"

# 3b. re-grant where the new rule cannot be written: the previous grant stays as it was
chmod a-w "$S/etc/sudoers.d"
if root root_grant 30 >/dev/null 2>&1; then rc=0; else rc=$?; fi
chmod u+w "$S/etc/sudoers.d"
check "failed staging: reports failure" test "$rc" -ne 0
check "failed staging: only the old timer left" test "$(timers)" -eq 1 -a "$(grep -c -- '-2000000600-' "$S/units")" -eq 1
check "failed staging: old marker kept" grep -qx 2000000600 "$M"
check "failed staging: old rule kept" cmp -s "$R" "$S/rule.before"

# 3c. re-grant where the swap fails, at the rule (marker already swapped) or at
# the marker: marker and rule could disagree, so every grant ends
for target in zz-sudo-frei sudo-frei-until; do
  if FAIL_MV=$target root root_grant 30 >/dev/null 2>&1; then rc=0; else rc=$?; fi
  check "failed swap ($target): reports failure" test "$rc" -ne 0
  check "failed swap ($target): rule and marker gone" test ! -e "$R" -a ! -e "$M"
  check "failed swap ($target): nothing staged left" test ! -e "$R.new" -a ! -e "$M.new"
  check "failed swap ($target): no timers" test "$(timers)" -eq 0
  root root_grant 15 >/dev/null
  check "failed swap ($target): next grant works" grep -qx 2000000600 "$M"
done

# 4. bad minutes are refused inside the root part too
for m in 0 241 010x 99999; do
  if root root_grant "$m" >/dev/null 2>&1; then rc=0; else rc=$?; fi
  check "root refuses minutes '$m'" test "$rc" -ne 0
done
check "refused minutes: old marker kept" grep -qx 2000000600 "$M"

# 5. sudo-rs (no NOTAFTER): falls back to the plain rule
FAIL_NOTAFTER=1 root root_grant 5 >/dev/null
check "sudo-rs: plain rule" grep -qx 'tester ALL=(ALL:ALL) NOPASSWD: ALL' "$R"
cp "$R" "$S/rule.after-sudo-rs"

# 6. while another run holds the lock, a grant waits LOCK_WAIT seconds, then gives up unchanged
flock "$S/run/sudo-frei/lock" sleep 3 &
holder=$!
sleep 0.5
if LOCK_WAIT=1 root root_grant 5 >/dev/null 2>&1; then rc=0; else rc=$?; fi
wait "$holder"
check "lock busy: grant refused" test "$rc" -ne 0
check "lock busy: nothing changed" cmp -s "$R" "$S/rule.after-sudo-rs"

# 6b. a marker from the pre-rename version is cleaned up by revoke
touch "$S/run/sudo-frei-ende"

# 6c. the final check of all sudoers files fails: everything is removed
if FAIL_CHECK=1 root root_grant 5 >/dev/null 2>&1; then rc=0; else rc=$?; fi
check "failed final check: reports failure" test "$rc" -ne 0
check "failed final check: rule and marker gone" test ! -e "$R" -a ! -e "$M"
check "failed final check: no timers" test "$(timers)" -eq 0
root root_grant 5 >/dev/null

# 6d. the rule cannot be removed: the marker and the timer stay, so status
# keeps showing the grant and the timer can still end it
if FAIL_RM=zz-sudo-frei root root_revoke >/dev/null 2>&1; then rc=0; else rc=$?; fi
check "stuck rule, revoke: reports failure" test "$rc" -ne 0
check "stuck rule, revoke: marker kept" test -e "$R" -a -e "$M"
check "stuck rule, revoke: timer kept" test "$(timers)" -eq 1
if FAIL_MV=zz-sudo-frei FAIL_RM=zz-sudo-frei root root_grant 30 >/dev/null 2>&1; then rc=0; else rc=$?; fi
check "stuck rule, failed swap: reports failure" test "$rc" -ne 0
check "stuck rule, failed swap: marker kept" test -e "$R" -a -e "$M"
check "stuck rule, failed swap: timers kept" test "$(timers)" -ge 1

# 7. revoke
touch "$R.new.tmp" "$M.new.tmp" "$S/etc/tmpfiles.d/sudo-frei.conf.tmp"
root root_revoke
check "revoke: rule gone" test ! -e "$R"
check "revoke: marker gone" test ! -e "$M"
check "revoke: no staged or temp files" test -z "$(find "$S/etc" "$S/run" -name '*.new' -o -name '*.tmp')"
check "revoke: legacy marker gone" test ! -e "$S/run/sudo-frei-ende"
check "revoke: no timers" test "$(timers)" -eq 0
check "revoke: sudo timestamps gone (name and uid)" test ! -e "$S/run/sudo/ts/tester" -a ! -e "$S/run/sudo/ts/1000"

echo
echo "sandbox: $S"
if ((fails)); then
  echo "$fails check(s) failed."
  exit 1
fi
echo "all checks passed."
